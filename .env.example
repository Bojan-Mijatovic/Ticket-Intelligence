# Copy to .env and fill in. .env is git-ignored.

# 1 = use the demo data in .claude/skills/analyze-ticket/fixtures (no Jira needed)
JIRA_MOCK=1

JIRA_BASE_URL=https://your-company.atlassian.net
# cloud | server   (server = Jira Server / Data Center)
JIRA_DEPLOYMENT=cloud

# Jira Cloud: email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Server / Data Center: Personal Access Token (used instead of email+token when set)
JIRA_PAT=

# Optional override of config.json "environmentField", e.g. customfield_10050
JIRA_ENV_FIELD=

# SVN projects: path to svn.exe when it is not on PATH and not in the TortoiseSVN / SlikSVN default folder
# (TortoiseSVN needs the "command line client tools" option ticked at install time).
SVN_BIN=
