# Copy to .env and fill in. .env is git-ignored.

# 1 = use the demo data in .claude/skills/analyze-ticket/fixtures (no Jira needed)
JIRA_MOCK=1

JIRA_BASE_URL=https://your-company.atlassian.net
# cloud | server   (server = Jira Server / Data Center)
JIRA_DEPLOYMENT=cloud

# Jira Cloud: email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Server / Data Center: Personal Access Token (used instead of email+token when set)
JIRA_PAT=

# Optional override of config.json "environmentField", e.g. customfield_10050
JIRA_ENV_FIELD=

# SVN projects: path to svn.exe when it is not on PATH and not in the TortoiseSVN / SlikSVN default folder
# (TortoiseSVN needs the "command line client tools" option ticked at install time).
SVN_BIN=

# Owner notifications in a Teams channel (Workflows webhook); without it they are shown on the dashboard only.
TEAMS_WEBHOOK_URL=

# Update emails from the agent (policy.json "emailUpdates"): one email per milestone of a ticket, to MAIL_TO.
# Gmail: SMTP_USER is the Gmail address, SMTP_PASS an app password (https://myaccount.google.com/apppasswords,
# needs 2-step verification). Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# sender address, default SMTP_USER
MAIL_FROM=
# recipients, comma separated (a test or team inbox)
MAIL_TO=
